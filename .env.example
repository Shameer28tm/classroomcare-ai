# ClassroomCare AI - Environment Configuration Template
# Copy this file to .env and configure values for your environment.
# NEVER commit .env with real credentials into version control.

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME="ClassroomCare AI — NIU Facilities & Campus Operations"
API_V1_PREFIX="/api/v1"
SECRET_KEY=change-this-to-a-secure-random-secret-key-at-least-32-chars

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Database & Supabase Configuration
# Required for production persistence. For local test suite, in-memory repository is provided.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-private-service-role-key
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres

# AI Provider Configuration (Google Gemini)
# Provider choices: gemini | mock (for offline tests and CI)
LLM_PROVIDER=mock
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768

# RAG & Knowledge Configuration
RAG_SIMILARITY_THRESHOLD=0.65
RAG_MAX_RESULTS=5
RAG_MAX_REPLAN_ATTEMPTS=2

# Safety & Alert Emergency Overrides (NIU Verified Contacts)
EMERGENCY_CONTACT_PHONE="(+91) 4651-250 566 / 112"
EMERGENCY_EHS_EMAIL="info@niuniv.com"
ENABLE_DEMO_DATA=true

# Frontend Configuration (exposed to Vite)
VITE_API_URL=http://localhost:8000/api/v1
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-public-anon-key
VITE_SUPABASE_ANON_KEY=your-public-anon-key
VITE_ENABLE_DEMO_FIXTURES=true
